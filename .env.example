# Copy to `.env` and fill in. `.env` is gitignored — never commit a real key.
#
#   cp .env.example .env
#
# NONE of this is needed to reproduce submission.json. The shipped file is produced by the
# deterministic keyword classifier and makes zero API calls:
#
#   DATASET_DIR=dataset/real/agentic-bank-hidden python -m pipeline.cli eventday \
#       --ledger dataset/real/agentic-bank-hidden/master_ledger_2025.csv --no-llm
#
# You only need a key for the optional LLM paths: `--classifier hybrid|gemini` and `cli ocr`.


# --- credentials -----------------------------------------------------------------------
# An AI Studio API key (starts with "AIza"): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# How the key is sent.
#   key    -> as ?key=<KEY> on the URL   (correct for an AI Studio API key — the default)
#   query  -> same as `key`
#   bearer -> as `Authorization: Bearer <TOKEN>` (only for an OAuth / session token)
GEMINI_AUTH_MODE=key


# --- models ----------------------------------------------------------------------------
# The workhorse: transaction classification, covenant enrichment, image OCR. `flash-lite` has
# the highest free-tier limits and is the right default for a classification workload.
GEMINI_MODEL_FLASH=gemini-flash-lite-latest

# Reported in submission.json's "model" field, and used where a stronger model is wanted.
GEMINI_MODEL_PRO=gemini-pro-latest

# NOTE: free-tier request pools are small and PER MODEL, so when one 429s another alias may
# still have quota. `gemini-2.5-*` ids are gated on some keys — prefer the `-latest` aliases,
# and confirm in one call with:  python -m pipeline.cli check
# To run on a different provider entirely, see MODELS.md.


# --- throttling ------------------------------------------------------------------------
# Minimum seconds between API calls, to stay under the free tier's requests-per-minute cap.
# Raise it if you see 429s; the client also honours the server's own retry-after.
GEMINI_MIN_INTERVAL=4


# --- dataset ---------------------------------------------------------------------------
# Which archive to run against: the directory holding `documents/` and
# `submission_template.json`. Usually passed per-command rather than set here, because
# getting it wrong is silent — unset, the pipeline reads the PRACTICE release in `dataset/`
# (12 borrowers, 36 cells) and writes a valid submission for the wrong contest.
#
# DATASET_DIR=dataset/real/agentic-bank-hidden
